{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make status)",
      "Bash(make logs:*)",
      "Bash(make plan)",
      "Bash(make plan ENV=dev)",
      "Bash(make plan ENV=prod)",
      "Bash(make deploy)",
      "Bash(make deploy ENV=dev:*)",
      "Bash(scripts/run-workflow.sh plan.yml:*)",
      "Bash(scripts/run-workflow.sh deploy.yml -f env=dev:*)",
      "Bash(gh workflow run plan.yml:*)",
      "Bash(gh workflow run deploy.yml -f env=dev:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(gofmt:*)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx expo install --check)",
      "Bash(terraform fmt:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(make deploy ENV=prod:*)",
      "Bash(make mobile-build:*)",
      "Bash(scripts/run-workflow.sh deploy.yml -f env=prod:*)",
      "Bash(scripts/run-workflow.sh mobile-release.yml:*)",
      "Bash(gh workflow run deploy.yml -f env=prod:*)",
      "Bash(gh workflow run mobile-release.yml:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)",
      "Bash(make setup)"
    ],
    "deny": [
      "Bash(scripts/run-workflow.sh destroy.yml:*)",
      "Bash(scripts/run-workflow.sh setup.yml:*)",
      "Bash(gh workflow run destroy.yml:*)",
      "Bash(gh workflow run setup.yml:*)",
      "Bash(gh secret:*)",
      "Bash(devops/scripts/deploy-backend.sh:*)",
      "Bash(devops/scripts/deploy-web.sh:*)",
      "Bash(devops/scripts/tf.sh:*)",
      "Bash(ALLOW_LOCAL_DEPLOY=1:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws:*)",
      "Read(./**/.env)",
      "Read(./**/*.tfstate)"
    ]
  },
  "extraKnownMarketplaces": {
    "hashicorp": {
      "source": { "source": "github", "repo": "hashicorp/agent-skills" }
    }
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
